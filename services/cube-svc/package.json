{
  "name": "cube-svc",
  "version": "1.0.0",
  "description": "CubeCommons API as a Cloudflare Worker",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:production": "wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --env dev --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "wrangler dev --env dev"
  },
  "license": "ISC",
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "crypto-js": "^4.2.0",
    "he": "^1.2.0",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "mime": "^3.0.0",
    "pg": "^8.16.3",
    "qs": "^6.14.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime": "^3.0.4",
    "@types/pg": "^8.15.4",
    "@types/qs": "^6.14.0",
    "@types/validator": "^13.15.10",
    "jsonwebtoken": "^9.0.2",
    "typescript": "^5.8.3",
    "uuid-encoder": "^1.2.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.162.0"
  }
}
